# ── Server ──
PORT=4000

# ── Database ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/application"  # pragma: allowlist secret

# ── Better Auth ──
# Secret used to sign cookies/tokens (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""
# Public URL the API is reachable at (used for OAuth callbacks)
BETTER_AUTH_URL="http://localhost:4000"
# Comma-separated list of origins allowed to make credentialed requests
TRUSTED_ORIGINS="http://localhost:3000"

# ── Cognito (social provider) ──
COGNITO_CLIENT_ID=""
COGNITO_DOMAIN="" # e.g. "your-app.auth.us-east-1.amazoncognito.com"
AWS_DEFAULT_REGION="" # e.g. "us-east-1"
COGNITO_USERPOOL_ID=""

# ── Graph store (bolt) ──
# Bolt endpoint for the knowledge graph. Takes precedence over MEMGRAPH_URL;
# leave both unset to serve empty graphs (no graph infrastructure required).
GRAPH_BOLT_URL="bolt://localhost:7687"
# "none" (Memgraph) or "sigv4" (Neptune IAM auth over bolt+ssc://…:8182)
GRAPH_AUTH="none"

# ── Durable Streams (docker-compose durable-streams, port 4437) ──
# Read origin used by the /v1/stream/:streamId proxy (live run token tails).
STREAMS_URL="http://localhost:4437"

# ── Electric SQL (docker-compose electric, port 3010) ──
# Shape API origin used by the /sync/:shape proxy.
ELECTRIC_URL="http://localhost:3010"
# Electric Cloud only (leave unset for local ELECTRIC_INSECURE dev):
# ELECTRIC_SOURCE_ID=""
# ELECTRIC_SECRET=""

# ── AgentCore Gateway (project-scoped harness tools) ──
# MCP endpoint of the AgentCore Gateway; leave unset to invoke the harness
# without gateway tools (e.g. local dev without deployed infra).
AGENTCORE_GATEWAY_URL=""
# Cognito M2M app client (client_credentials grant) allowed by the gateway's
# JWT authorizer — see the Cognito stack's GatewayM2mClientId output.
GATEWAY_M2M_CLIENT_ID=""
GATEWAY_M2M_CLIENT_SECRET=""
GATEWAY_OAUTH_SCOPE="agentcore-gateway/invoke"

# ── Orchestrated run dispatch ──
# Local dev: POST run pointers to the locally running agentcore server
# (apps/worker `pnpm dev`, port 8080). Deployed, AGENTCORE_RUNTIME_ARN is set
# instead and dispatch goes through InvokeAgentRuntime.
AGENTCORE_LOCAL_URL="http://localhost:8080"
# AGENTCORE_RUNTIME_ARN=""
