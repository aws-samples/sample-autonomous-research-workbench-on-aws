DATABASE_URL="postgresql://postgres:postgres@localhost:5432/application"  # pragma: allowlist secret
STREAMS_URL="http://localhost:4437"

# Local dev: dispatch run pointers to this locally running agentcore server
# over plain HTTP instead of calling InvokeAgentRuntime.
AGENTCORE_LOCAL_URL="http://localhost:8080"

# Deployed (set by the infra stack, not needed locally):
# AGENTCORE_RUNTIME_ARN_PARAM=/research-workbench/agentcore/run-runtime-arn
# DB_SECRET_ARN=arn:aws:secretsmanager:...
# Local dev: back the project-files shell tool with a local directory
# (deployed project runtimes get /mnt/files — the project's S3 Files mount).
# PROJECT_FILES_DIR=/tmp/research-workbench-project-files
